{
  "name": "miniprogram-platform",
  "version": "1.2.0",
  "license": "MIT",
  "author": "Xingzeng Bao",
  "homepage": "https://github.com/baoxingzeng/miniprogram-platform",
  "description": "Zero-dependency platform detection for mini-program ecosystems.",
  "type": "module",
  "main": "dist/miniprogram-platform.cjs.js",
  "module": "dist/miniprogram-platform.esm.js",
  "unpkg": "dist/miniprogram-platform.umd.js",
  "jsdelivr": "dist/miniprogram-platform.umd.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "!dist/types/**/*",
    "!dist/cjs/types/**/*",
    "!dist/esm/types/**/*"
  ],
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup --config",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "miniprogram",
    "wechat",
    "alipay"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.61.0",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1"
  }
}